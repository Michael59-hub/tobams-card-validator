{
  "compilerOptions": {
    "target": "ES2022",                          
    "module": "node16",
    "moduleResolution": "node16",             
    "outDir": "./dist",                         
    "rootDir": "./src",                          
    "sourceMap": true,                           
    "strict": true,                              
    "noImplicitAny": true,                       
    "strictNullChecks": true,                    
    "esModuleInterop": true,
    "skipLibCheck": true                
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "tests/**/*"
  ]
}